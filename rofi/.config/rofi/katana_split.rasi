* {
    bg-obsidian:     #111418;
    bg-charcoal:     #181c22;
    bg-selection:    #20252d;
    fg-lightest:     #f8fbff;
    fg-steel:        #c7d2e0;
    fg-muted:        #6b7280;
    border-slate:    #4b5563;
    accent-blue:     #6ea8fe;
    accent-red:      #ef6f6c;

    background-color: transparent;
    text-color:       @fg-steel;
    font:             "JetBrainsMono Nerd Font 10";
}

window {
    width:            780px;
    height:           420px;
    background-color: @bg-obsidian;
    border:           1px;
    border-color:     @border-slate;
    border-radius:    8px;
}

mainbox {
    orientation:      horizontal;
    children:         [ left-pane, right-pane ];
}

left-pane {
    orientation:      vertical;
    width:            310px;
    background-color: @bg-charcoal;
    padding:          28px 22px;
    spacing:          20px;
    border:           0px 1px 0px 0px;
    border-color:     @border-slate;
    children:         [ textbox-banner, inputbar, dummy, mode-switcher ];
}

left-pane {
    orientation:      vertical;
    width:            320px;
    background-color: @bg-charcoal;
    padding:          32px 24px;
    spacing:          18px;
    border:           0px 1px 0px 0px;
    border-color:     @border-slate;
    children:         [ dummy, icon-current-entry, inputbar, mode-switcher, dummy ];
}

textbox-banner {
    expand:           false;
    content:          "A R C H // W M";
    font:             "The Last Shuriken 20";
    text-color:       @fg-lightest;
    horizontal-align: 0.5;
    padding:          10px 0px;
}

inputbar {
    children:         [ entry ];
    background-color: @bg-obsidian;
    border:           1px;
    border-color:     @accent-blue;
    border-radius:    6px;
    padding:          10px 14px;
}

entry {
    text-color:       @fg-lightest;
    placeholder:      "Search apps...";
    placeholder-color:@fg-muted;
}

dummy {
    background-color: transparent;
}

mode-switcher {
    orientation:      vertical;
    spacing:          6px;
}

button {
    padding:          8px 12px;
    border-radius:    6px;
    background-color: @bg-obsidian;
    text-color:       @fg-muted;
    horizontal-align: 0.0;
}

button selected {
    background-color: @bg-selection;
    text-color:       @accent-blue;
}

right-pane {
    orientation:      vertical;
    padding:          18px;
    children:         [ listview ];
}

listview {
    lines:            8;
    columns:          1;
    spacing:          4px;
    scrollbar:        false;
}

element {
    padding:          9px 14px;
    border-radius:    6px;
}

element-icon {
    size:             22px;
    margin:           0px 12px 0px 0px;
    vertical-align:   0.5;
}

element-text {
    vertical-align:   0.5;
}

element selected {
    background-color: @bg-selection;
    text-color:       @accent-red;
}
