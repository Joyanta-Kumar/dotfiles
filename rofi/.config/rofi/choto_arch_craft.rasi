* {
    crust: #111418;
    green: #7dd36f;
    red: #ef6f6c;
    bg-col:  @crust;
    bg-col-light: #181c22;
    border-col: @crust;
    selected-col: #20252d;
    blue: #6ea8fe;
    fg-col: #c7d2e0;
    fg-col2: #ef6f6c;
    grey: #6b7280;
    width: 600;
    font: "JetBrainsMono Nerd Font 10";
}

element-text, element-icon, mode-switcher {
    background-color: inherit;
    text-color:       inherit;
}

window {
    height: 480px;
    width: 740px;
    border: 2px;
    border-color: @blue;
    background-color: @bg-col;
    border-radius: 10px;
}

mainbox {
    background-color: @bg-col;
    padding: 15px;
}

inputbar {
    children: [prompt, entry];
    background-color: @bg-col-light;
    border-radius: 8px;
    padding: 4px;
    margin: 0px 0px 15px 0px;
}

prompt {
    background-color: @blue;
    padding: 8px 12px;
    text-color: @bg-col;
    border-radius: 6px;
    margin: 0px;
}

textbox-prompt-colon {
    expand: false;
    str: "";
}

entry {
    padding: 8px;
    margin: 0px 0px 0px 5px;
    text-color: @fg-col;
    background-color: transparent;
    vertical-align: 0.5;
}

listview {
    border: 0px;
    padding: 4px;
    margin: 0px;
    columns: 2;
    lines: 5;
    spacing: 6px;
    background-color: @bg-col;
}

element {
    padding: 10px 12px;
    background-color: transparent;
    text-color: @fg-col;
    border-radius: 6px;
}

element-icon {
    size: 24px;
    margin: 0px 10px 0px 0px;
}

element selected {
    background-color: @selected-col;
    text-color: @red;
}

mode-switcher {
    spacing: 10px;
    margin: 15px 0px 0px 0px;
}

button {
    padding: 10px;
    background-color: @bg-col-light;
    text-color: @grey;
    vertical-align: 0.5; 
    horizontal-align: 0.5;
    border-radius: 6px;
}

button selected {
    background-color: @blue;
    text-color: @bg-col;
}

message {
    background-color: @bg-col-light;
    margin: 10px 0px 0px 0px;
    padding: 8px;
    border-radius: 6px;
}

textbox {
    padding: 6px;
    text-color: @blue;
    background-color: transparent;
}
